[
  {
    "id": "1786049825290-ekm7d0",
    "text": "הקדמה"
  },
  {
    "id": "1786049833495-gg2s1q",
    "text": "עולה לא פעם לדיון המחלוקת באשר"
  },
  {
    "id": "1786049845983-4z4bmu",
    "text": "מצד אחד קיימת סברה המצדדת בתפיסה זו, זאת מתוך שאיפה ל"
  },
  {
    "id": "1786049865544-pd05xz",
    "text": "מנגד, יש המטילים בכך ספק. לטענתם"
  },
  {
    "id": "1786049884857-m4tz0u",
    "text": "לעניות דעתי, גישה שנייה זו עדיפה על פני חלופתה, שכן היא משקפת נאמנה את"
  },
  {
    "id": "1786049889642-rz9gia",
    "text": "בראש ובראשונה,"
  },
  {
    "id": "1786049892635-su11yk",
    "text": "הדבר נובע מ"
  },
  {
    "id": "1786049896190-3gtyfx",
    "text": "לדוגמה,"
  },
  {
    "id": "1786049900127-0ejars",
    "text": "נוסף על האמור לעיל,"
  },
  {
    "id": "1786049905362-9wunkg",
    "text": "ניתן לייחס זאת"
  },
  {
    "id": "1786049911070-vyh9ix",
    "text": "כך למשל, במקרה בו"
  },
  {
    "id": "1786049921563-chhyjr",
    "text": "מנגד, קיימת הטענה כי מן הראוי להתמקד ב"
  },
  {
    "id": "1786049928516-no3xb0",
    "text": "השקפה זו מושתת על ההנחה כי"
  },
  {
    "id": "1786049934606-v40k2s",
    "text": "עם זאת, בחינה מעמיקה של הדברים מעלה כי"
  },
  {
    "id": "1786049938101-h46fgj",
    "text": "ניכר ש"
  },
  {
    "id": "1786049943081-yfqp1r",
    "text": "עיון במקרה בו"
  },
  {
    "id": "1786049949951-ma2fvp",
    "text": "מלמד על כך ש"
  },
  {
    "id": "1786049959274-yhmj35",
    "text": "לסיכום, אני סבור כי"
  },
  {
    "id": "1786049972399-yt9ckc",
    "text": "הן ה והן ה, מעידים כי גישה זו מהווה את המענה ההולם ביותר לסוגיה."
  }
]
